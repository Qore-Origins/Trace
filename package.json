    "react-dom": "^19.0.0",
    "zustand": "^4.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",

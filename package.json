{
  "name": "trace",
  "version": "0.15.1",
  "description": "溯源 Trace · by Qore —— 计划有迹可循的桌面计划管理软件",
  "main": "./out/main/index.js",
  "author": "Qore <Qore-Origins>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "demo:muya": "vite --config demo/muya-note-editor/vite.config.ts",
    "demo:muya:build": "vite build --config demo/muya-note-editor/vite.config.ts",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "migrate:md": "esbuild scripts/migrate-md-library.ts --bundle --platform=node --format=esm --outfile=scripts/migrate-md-library.mjs && node scripts/migrate-md-library.mjs",
    "build:win": "electron-vite build && electron-builder --win --x64",
    "icon": "node scripts/make-ico.mjs",
    "plantuml:prepare": "node scripts/prepare-plantuml-runtime.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@muyajs/core": "file:vendor/muya",
    "antd": "^5.0.0",
    "chokidar": "^5.0.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.2",
    "plantuml-encoder": "1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.13",
    "zustand": "^4.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "@types/plantuml-encoder": "^1.4.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.6",
    "@types/underscore": "^1.13.0",
    "@types/webfontloader": "^1.6.38",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "png2icons": "^2.0.1",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
